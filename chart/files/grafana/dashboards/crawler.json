  {
   "id": 2,
   "type": "stat",
   "title": "Crawls running",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "sum(chatgsi_crawl_active) or vector(0)",
     "refId": "A",
     "range": true,
     "legendFormat": "__auto"
    }
   ],
   "description": "A wiki crawl legitimately runs for hours. Length is not a fault signal; the heartbeat next to it is.",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto"
   }
  },
