     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "chatgsi_active_users{window=\"1d\"} / clamp_min(chatgsi_active_users{window=\"30d\"}, 1)",
     "refId": "A",
     "range": true,
     "legendFormat": "__auto"
    }
   ],
   "description": "Stickiness. 1.0 on a tiny user base means everybody who has ever logged in used it today \u2014 flattering and not yet meaningful.",
