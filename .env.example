# --- GSI LLM proxy -----------------------------------------------------------
# Paths verified 2026-07-27. NOTE: info.md documents /api/chat/completions, which
# returns 403. The working base is /api/v1 (chat at /api/v1/chat/completions).
LLM_BASE_URL=http://192.168.50.1:8080/api/v1
LLM_API_KEY=pk-praktikum2026
CHAT_MODEL=llmbot.mistral-small-4-119b
CRAWL_MODEL=llmbot.qwen3.6-27b
UTILITY_MODEL=llmbot.gpt-oss-120b
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
LLM_CONTEXT_WINDOW=200000
EMBED_BATCH_SIZE=32

# --- database ----------------------------------------------------------------
POSTGRES_DB=llmbot
POSTGRES_USER=llmbot
POSTGRES_PASSWORD=change-me

# --- keycloak ----------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
OIDC_ISSUER=http://keycloak.localhost:8081/realms/gsi
OIDC_CLIENT_ID=chat-gsi-de
OIDC_CLIENT_SECRET=change-me
APP_ORIGIN=http://localhost:3000
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_SECRET=change-me-to-32-random-bytes
# External IdP support. Where roles live in the token (Keycloak realm roles are
# realm_access.roles; a top-level client mapper would be `roles`).
OIDC_ROLES_CLAIM=realm_access.roles
# Alias an EXTERNAL realm's role names to the app's canonical roles, as JSON.
# Empty for the bundled Keycloak (it already issues llmbot-*). Example:
#   OIDC_ROLE_ALIASES={"llmbot-admin":"gsi-admin","llmbot-user":["employee","staff"]}
OIDC_ROLE_ALIASES=

# --- orchestrator ------------------------------------------------------------
MAX_ROUNDS=3
MAX_SUBAGENTS_PER_ROUND=4
DEEP_WALL_CLOCK_BUDGET_S=180
RETRIEVE_TOP_K=40
CONTEXT_CHUNKS_FAST=8
CONTEXT_CHUNKS_DEEP=12

# --- crawler -----------------------------------------------------------------
# wiki.gsi.de robots.txt sets Crawl-delay: 5. The Foswiki connector enforces that
# floor regardless of this value.
CRAWL_RATE_LIMIT_RPS=0.2
CRAWL_USER_AGENT="gsi-llmbot-crawler/1.0 (+https://chat.gsi.de)"
CRAWL_VISION_ENABLED=true
# Let the crawl model convert pages to Markdown instead of heuristic HTML parsing.
CRAWL_LLM_EXTRACTION=true

# --- external documents agent ------------------------------------------------
# Searches indico.gsi.de, repository.gsi.de and the PDFs that crawled pages link
# to, on EVERY turn. It is off the critical path (started before retrieval,
# awaited just before the answer) and can never fail a turn, so the cost of
# leaving it on is a handful of HTTP requests per question.
#
# Set false to turn it off entirely -- answers then come from the corpus alone.
DOCS_AGENT_ENABLED=true
# How many documents may actually be downloaded and read per turn. Each is a
# real fetch from a real GSI server, so this is the knob that matters.
DOCS_AGENT_MAX_READS=3
# Characters of extracted text one document contributes. A 60-page thesis is
# ~200k characters and would take the whole context window on its own; the
# opening of a paper is where the abstract and conclusions are.
DOCS_AGENT_MAX_TEXT_CHARS=12000

# --- uploads -----------------------------------------------------------------
# Per-user upload quota. Default 1 GiB.
UPLOAD_QUOTA_BYTES=1073741824
# Per file, 4 MiB. NOTE: adapter-node caps request bodies itself and defaults to
# 512K, so this alone does nothing -- BODY_SIZE_LIMIT on the Deployment
# (k8s/40-frontend.yaml) must stay comfortably above it, or the socket closes
# before the app can answer with a real 413.
UPLOAD_MAX_FILE_BYTES=4194304
# Characters of extracted text one attached document contributes to a turn.
# Uploads that are not images (PDF, pptx, docx, xlsx, odp/odt/ods) are run
# through the same extractor the documents agent uses and handed to the model as
# TEXT -- a vision model cannot read a base64 PDF.
UPLOAD_MAX_ATTACHMENT_CHARS=30000
# Object storage (SeaweedFS S3 gateway). Sharding: scale the `volume` service.
S3_ENDPOINT=http://seaweed-s3:8333
S3_REGION=us-east-1
S3_BUCKET=gsi-uploads
S3_ACCESS_KEY=gsi-chat
S3_SECRET_KEY=change-me
# Public origin the browser is redirected to for direct downloads.
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Lifetime of an issued direct link.
S3_LINK_TTL_SECONDS=300

# --- access control (plan.md 8b) ---
# Read-only Keycloak service account: lists realm users for the admin picker.
# It holds view-users/query-users and nothing that can write.
KEYCLOAK_BASE_URL=http://keycloak.localhost:8081
KEYCLOAK_REALM=gsi
KEYCLOAK_ADMIN_CLIENT_ID=chat-gsi-de-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
# How long a conversation stays hidden after a revocation before it is purged.
REVOCATION_GRACE_DAYS=30

# --- observability -----------------------------------------------------------
# One metrics server: the frontend exposes a single /metrics that also collects
# from Postgres, SeaweedFS, Valkey, Keycloak and the crawl_runs table at scrape
# time. There is nothing else for Prometheus to scrape.
METRICS_ENABLED=true
# Bearer token for /metrics. EMPTY on the lab subnet, which is deliberately open
# (AGENTS.md 1). Set it if this ever gets an internet-facing ingress: the
# exposition names users in chatgsi_user_stored_bytes.
METRICS_TOKEN=
# How long a scrape-time collector's answer is reused. Prometheus scrapes every
# 15s; without this a Grafana panel on auto-refresh re-runs the storage
# aggregation on every browser tick.
METRICS_CACHE_SECONDS=15
# Per-backend timeout inside one scrape. Must stay under prometheus.yml's
# scrape_timeout (10s).
METRICS_TIMEOUT_SECONDS=5
# Shown on the overview dashboard as chatgsi_build_info.
APP_VERSION=dev

# SeaweedFS master, for cluster metrics only -- object access goes through the
# S3 gateway. Volume servers are discovered from the master's topology, so
# scaling the volume StatefulSet needs no change here.
S3_MASTER_URL=http://seaweed-master:9333
# Keycloak's MANAGEMENT port, where /health lives. Separate from
# KEYCLOAK_BASE_URL, which is the issuer host and must stay byte-identical to
# what the browser uses (AGENTS.md 5).
KEYCLOAK_MANAGEMENT_URL=http://keycloak:9000

# Planned object-storage capacity: the denominator of the headline gauge on the
# Storage dashboard. 25 TiB. This is a TARGET, not a measurement -- the lab node
# does not have 25 TB attached, and the real filesystem is reported separately as
# chatgsi_seaweed_disk_bytes.
S3_CAPACITY_BYTES=27487790694400

# --- grafana -----------------------------------------------------------------
# Access is llmbot-admin ONLY, enforced by role_attribute_strict against the
# `roles` claim from the grafana client in deploy/keycloak/realm-gsi.json.
# A user without the role is refused at login rather than given a read-only view.
GRAFANA_ROOT_URL=http://localhost:3001
GRAFANA_OIDC_CLIENT_ID=grafana
# Must match the `secret` on the grafana client in realm-gsi.json, exactly as
# OIDC_CLIENT_SECRET must (AGENTS.md 6): a mismatch fails at token exchange,
# well after the login page appears to work.
GRAFANA_OIDC_CLIENT_SECRET=dev-grafana-client-secret-change-me
# Only reachable when GRAFANA_DISABLE_LOGIN_FORM=false. That is the recovery
# path for a broken Keycloak, not a second way in -- leave the form disabled.
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DISABLE_LOGIN_FORM=true

# --- status page (independent of everything else) ----------------------------
# Uptime Kuma runs on uptime.lab and owns the checks; the AI agent reads its
# database read-only and publishes status.lab. Neither depends on the app, and
# the app does not depend on them.
STATUS_POLL_SECONDS=30
# Without an LLM key the agent still runs and publishes deterministic summaries;
# it never silently stops reporting. Set false to force that path.
STATUS_AI_ENABLED=true
# Defaults to UTILITY_MODEL. A small fast model is the right choice here -- the
# output is three sentences.
STATUS_MODEL=
# Extra context for incident text, best-effort. The agent works without it, which
# matters because Prometheus is likely down during the outages this reports on.
STATUS_PROMETHEUS_URL=http://prometheus:9090
STATUS_PROMETHEUS_ENABLED=true
# Uptime Kuma API key. Used for LIVE status and response time via /metrics --
# the only route an API key unlocks, and a snapshot with no history, so the
# read-only database mount is still what answers "was it slow for two minutes".
# Empty falls back to the database entirely.
KUMA_API_KEY=uk1_change-me
# Uptime Kuma admin, used ONLY to create the default monitors on first run.
# Leave empty to skip provisioning and configure checks by hand.
KUMA_ADMIN_USER=admin
KUMA_ADMIN_PASSWORD=change-me
