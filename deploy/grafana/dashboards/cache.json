   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "sum(chatgsi_cache_entries) or vector(0)",
     "refId": "A",
     "range": true,
     "legendFormat": "__auto"
    }
   ],
   "description": "7-day cache of public www.gsi.de PDFs fetched on a user's behalf (migration 014). Deliberately outside user quota \u2014 this dashboard is the only place its size is counted.",
