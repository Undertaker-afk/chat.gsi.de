  {
   "id": 38,
   "type": "gauge",
   "title": "Hit rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 0,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.3
       },
       {
        "color": "green",
        "value": 0.6
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "sum(rate(chatgsi_external_cache_requests_total{result=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(chatgsi_external_cache_requests_total{result=~\"hit|miss\"}[$__rate_interval])), 0.0001)",
     "refId": "A",
     "range": true,
     "legendFormat": "__auto"
    }
   ],
   "description": "Every hit is a PDF www.gsi.de did not have to serve. A low rate is not necessarily wrong \u2014 it means people are opening different documents, not the same ones.",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdLabels": false,
    "showThresholdMarkers": true,
    "minVizWidth": 75,
    "minVizHeight": 75,
    "sizing": "auto"
   }
  },
  {
   "id": 39,
   "type": "timeseries",
   "title": "Cache lookups",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 10,
    "x": 6,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "axisLabel": "",
      "scaleDistribution": {
       "type": "linear"
      },
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "unit": "cpm"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "sum by (result) (rate(chatgsi_external_cache_requests_total[$__rate_interval]) * 60)",
     "refId": "A",
     "range": true,
     "legendFormat": "{{result}}"
    }
   ],
   "description": "`error` is the cache being broken while the document still gets served. It is deliberately not folded into `miss`, which would hide a dead cache behind a healthy hit rate.",
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
