   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "editorMode": "code",
     "expr": "sum(count_over_time({app=~\"$app\", namespace=\"chat-gsi\"} | json | __error__=\"\" | level =~ \"warn|warning\" [1h])) or vector(0)",
     "refId": "A",
     "range": true,
     "queryType": "range"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto"
   }
  },
  {
   "id": 5,
   "type": "stat",
