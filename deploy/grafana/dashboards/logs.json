        "uid": "loki"
       },
       "editorMode": "code",
       "expr": "{app=\"frontend\"} | json | __error__=\"\" | kind = \"access\" | status >= 400",
       "refId": "A",
       "range": true,
       "queryType": "range"
      }
     ],
     "description": "Every rejected request with its route, status, duration and user. This is the panel to open first when somebody says 'it did not work'.",
