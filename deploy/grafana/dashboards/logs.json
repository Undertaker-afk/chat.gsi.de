 },
 "templating": {
  "list": [
   {
    "name": "app",
    "label": "Component",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "app",
     "refId": "LokiVariableQueryEditor-VariableQuery",
     "stream": "",
     "type": 1
    },
    "refresh": 1,
    "includeAll": true,
    "allValue": ".+",
    "multi": true,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "options": [],
    "hide": 0,
    "sort": 1
   },
   {
    "name": "level",
    "label": "Level",
    "type": "custom",
    "query": "info,warn,error,debug",
    "includeAll": true,
    "allValue": ".+",
    "multi": true,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "options": [],
    "hide": 0
   },
   {
    "name": "search",
    "label": "Contains",
    "type": "textbox",
    "query": "",
    "current": {
     "selected": false,
     "text": "",
     "value": ""
    },
    "options": [],
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Volume",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Lines/min (all)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "cpm",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "editorMode": "code",
     "expr": "sum(rate({app=~\"$app\", namespace=\"chat-gsi\"} [$__auto])) * 60",
     "refId": "A",
     "range": true,
     "queryType": "range"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Errors (1h)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 25
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "editorMode": "code",
     "expr": "sum(count_over_time({app=~\"$app\", namespace=\"chat-gsi\"} | json | __error__=\"\" | level = \"error\" [1h])) or vector(0)",
     "refId": "A",
     "range": true,
     "queryType": "range"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Warnings (1h)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
