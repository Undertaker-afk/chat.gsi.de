     },
     "editorMode": "code",
     "expr": "sum(count_over_time({app=~\"$app\", namespace=\"chat-gsi\"} | json | __error__=\"\" | kind = \"access\" | status >= 500 [1h])) or vector(0)",
     "refId": "A",
     "range": true,
