  {
   "id": 6,
   "type": "stat",
   "title": "Components reporting",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "editorMode": "code",
     "expr": "count(count by (app) (count_over_time({app=~\"$app\", namespace=\"chat-gsi\"} [$__range]))) or vector(0)",
     "refId": "A",
     "range": true,
     "queryType": "range"
    }
   ],
   "description": "How many components have logged anything in the window. A component dropping off this count is the first sign it stopped running.",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto"
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Slowest request (1h)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "ms",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "editorMode": "code",
     "expr": "max_over_time({app=\"frontend\"} | json | __error__=\"\" | kind = \"access\" | unwrap duration_ms [1h]) or vector(0)",
     "refId": "A",
     "range": true,
     "queryType": "range"
    }
   ],
   "description": "From the access log's duration_ms. Note /api/chat returns its SSE stream immediately, so a long turn does not appear here.",
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto"
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Log volume by component",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "axisLabel": "",
      "scaleDistribution": {
       "type": "linear"
      },
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "unit": "cpm"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "editorMode": "code",
     "expr": "sum by (app) (rate({app=~\"$app\", namespace=\"chat-gsi\"} [$__auto])) * 60",
     "refId": "A",
     "range": true,
     "queryType": "range",
     "legendFormat": "{{app}}"
    }
   ],
   "description": "A sudden flat line for one component means it stopped logging \u2014 usually because it stopped running.",
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "right",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Log volume by level",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "axisLabel": "",
      "scaleDistribution": {
       "type": "linear"
      },
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "unit": "cpm"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "editorMode": "code",
     "expr": "label_replace(sum by (level) (rate({app=~\"$app\", namespace=\"chat-gsi\"} | json | __error__=\"\" [$__auto])) * 60, \"level\", \"warn\", \"level\", \"warning\")",
     "refId": "A",
     "range": true,
     "queryType": "range",
     "legendFormat": "{{level}}"
    }
   ],
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true
