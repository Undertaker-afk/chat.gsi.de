    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "type": "row",
   "title": "HTTP access log",
   "collapsed": true,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "panels": [
    {
     "id": 11,
     "type": "timeseries",
     "title": "Requests by status class",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "gridPos": {
      "h": 8,
      "w": 12,
      "x": 0,
      "y": 14
     },
     "fieldConfig": {
      "defaults": {
       "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 8,
        "gradientMode": "opacity",
        "showPoints": "never",
        "spanNulls": true,
        "axisLabel": "",
        "scaleDistribution": {
         "type": "linear"
        },
        "stacking": {
         "mode": "normal",
         "group": "A"
        }
       },
       "unit": "cpm"
      },
      "overrides": []
     },
     "targets": [
      {
       "datasource": {
        "type": "loki",
        "uid": "loki"
       },
       "editorMode": "code",
       "expr": "sum by (status) (rate({app=\"frontend\"} | json | __error__=\"\" | kind = \"access\" [$__auto])) * 60",
       "refId": "A",
       "range": true,
       "queryType": "range",
       "legendFormat": "{{status}}"
      }
     ],
     "description": "From the frontend's own access log, so it agrees with chatgsi_http_requests_total by construction. /metrics and /health are excluded at the source \u2014 two probes would otherwise be ~20k lines a day of 'a robot checked and all was well'.",
     "options": {
      "legend": {
       "calcs": [
        "mean",
        "max",
        "lastNotNull"
       ],
       "displayMode": "table",
       "placement": "right",
       "showLegend": true
      },
      "tooltip": {
       "mode": "multi",
       "sort": "desc"
      }
     }
    },
    {
     "id": 12,
     "type": "timeseries",
     "title": "Request duration p95 by route",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "gridPos": {
      "h": 8,
      "w": 12,
      "x": 12,
      "y": 14
     },
     "fieldConfig": {
      "defaults": {
       "custom": {
        "drawStyle": "line",
        "lineWidth": 1,
        "fillOpacity": 8,
        "gradientMode": "opacity",
        "showPoints": "never",
        "spanNulls": true,
        "axisLabel": "",
        "scaleDistribution": {
         "type": "linear"
        }
       },
       "unit": "ms"
      },
      "overrides": []
     },
     "targets": [
      {
       "datasource": {
        "type": "loki",
        "uid": "loki"
       },
       "editorMode": "code",
       "expr": "quantile_over_time(0.95, {app=\"frontend\"} | json | __error__=\"\" | kind = \"access\" | unwrap duration_ms [$__auto]) by (route)",
       "refId": "A",
       "range": true,
       "queryType": "range",
       "legendFormat": "{{route}}"
      }
     ],
     "description": "The same question the metrics answer, but sliced by anything in the log line rather than only by pre-chosen labels.",
     "options": {
      "legend": {
       "calcs": [
        "mean",
        "max",
        "lastNotNull"
       ],
       "displayMode": "table",
       "placement": "right",
       "showLegend": true
      },
      "tooltip": {
       "mode": "multi",
       "sort": "desc"
      }
     }
    },
    {
